---
// Akce jako vstupenka: vykousnuté půlkruhy, perforace a ústřižek s datem.
// Inspirováno studií Ticket od JP (dqnamo.com/kitchen), postaveno po svém
// (kulaté výřezy maskou, náklon a odlesk bez knihovny).
import { dayParts } from '../lib/url';

interface Props {
  nazev: string;
  datum: string;
  cas: string;
  vstupne: number;
  popis?: string;
  tone: number;
}

const { nazev, datum, cas, vstupne, popis, tone } = Astro.props;
const { day, month, weekday } = dayParts(datum);
---

<li class="ticket-wrap" data-datum={datum}>
  <div class="ticket" data-tilt data-tone={tone % 4}>
    <article class="ticket-paper">
      <div class="ticket-body">
        <p class="ticket-kicker">{weekday} · {cas}</p>
        <h3>{nazev}</h3>
        {popis && <p class="ticket-desc">{popis}</p>}
      </div>
      <div class="ticket-stub">
        <span class="ticket-date">{day}.&nbsp;{month}.</span>
        <span class="ticket-price">{vstupne > 0 ? `${vstupne} Kč` : 'Zdarma'}</span>
      </div>
      <span class="ticket-glare" aria-hidden="true"></span>
    </article>
  </div>
</li>

<style>
  .ticket-wrap {
    /* stín je na obalu, aby ho výřezy neusekly */
    filter: drop-shadow(0 1px 1px rgb(30 20 10 / 0.1)) drop-shadow(0 18px 24px rgb(30 20 10 / 0.14));
    perspective: 1100px;
  }

  .ticket {
    --paper-c: var(--accent);
    --ink-c: var(--ink);
    --sub-c: rgb(28 25 21 / 0.7);
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.22s var(--ease);
    will-change: transform;
  }

  .ticket[data-tone='1'] {
    --paper-c: var(--paper-3);
  }

  .ticket[data-tone='2'] {
    --paper-c: var(--olive);
    --ink-c: #f4efe6;
    --sub-c: rgb(244 239 230 / 0.75);
  }

  .ticket[data-tone='3'] {
    --paper-c: var(--ink);
    --ink-c: #f4efe6;
    --sub-c: rgb(244 239 230 / 0.68);
  }

  .ticket-paper {
    --notch: 13px;
    --stub: 108px;
    position: relative;
    height: 100%;
    min-height: 400px;
    display: grid;
    grid-template-rows: 1fr var(--stub);
    border-radius: 16px;
    overflow: hidden;
    color: var(--ink-c);
    background:
      linear-gradient(150deg, rgb(255 255 255 / 0.16), transparent 45%),
      var(--paper-c);
    -webkit-mask:
      radial-gradient(circle var(--notch) at 0 calc(100% - var(--stub)), #0000 97%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle var(--notch) at 100% calc(100% - var(--stub)), #0000 97%, #000) right / 51% 100% no-repeat;
    mask:
      radial-gradient(circle var(--notch) at 0 calc(100% - var(--stub)), #0000 97%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle var(--notch) at 100% calc(100% - var(--stub)), #0000 97%, #000) right / 51% 100% no-repeat;
  }

  .ticket-body {
    padding: 26px 24px 22px;
    display: flex;
    flex-direction: column;
  }

  .ticket-kicker {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sub-c);
  }

  .ticket h3 {
    margin-top: 14px;
    font-size: 30px;
    line-height: 1.02;
    font-weight: 420;
  }

  .ticket-desc {
    margin-top: auto;
    padding-top: 20px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--sub-c);
  }

  .ticket-stub {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0 24px;
  }

  /* perforace mezi vstupenkou a ústřižkem */
  .ticket-stub::before {
    content: '';
    position: absolute;
    top: -1px;
    left: calc(var(--notch) + 8px);
    right: calc(var(--notch) + 8px);
    border-top: 2px dashed currentColor;
    opacity: 0.28;
  }

  .ticket-date {
    font-family: var(--serif);
    font-size: 40px;
    font-weight: 380;
    letter-spacing: -0.03em;
    font-variant-numeric: lining-nums;
  }

  .ticket-price {
    font-size: 14px;
    font-weight: 650;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1.5px solid currentColor;
    white-space: nowrap;
  }

  /* odlesk, který jde za kurzorem */
  .ticket-glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(260px circle at var(--gx, 50%) var(--gy, 30%), rgb(255 255 255 / 0.22), transparent 60%);
    transition: opacity 0.3s var(--ease);
  }

  .ticket.is-tilting .ticket-glare {
    opacity: 1;
  }
</style>
