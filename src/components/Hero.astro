---
import data from '../data/web.json';
import { withBase } from '../lib/url';
import Scramble from './Scramble.astro';
import TactileButton from './TactileButton.astro';

const reservation = `mailto:${data.email}?subject=${encodeURIComponent('Rezervace stolu')}`;
---

<section class="hero wrap" id="top">
  <div class="hero-text">
    <p class="eyebrow">{data.podtitul}</p>
    <h1 class="hero-title">
      Káva, desky<br />a <Scramble words={data.slova} />
    </h1>
    <p class="hero-lead">{data.uvod}</p>
    <div class="hero-actions">
      <TactileButton href={reservation}>Rezervovat stůl</TactileButton>
      <a class="text-link" href="#akce">Co chystáme <span class="arrow" aria-hidden="true">↓</span></a>
    </div>
  </div>

  <figure class="hero-media">
    <img
      src={withBase(data.uvodni_foto)}
      alt="Interiér kavárny: dřevěný pult s gramofonem, regál plný desek a velká okna"
      width="2048"
      height="1360"
      fetchpriority="high"
    />
    <figcaption class="now-playing">
      <span class="np-disc" aria-hidden="true"><span class="np-label"></span></span>
      <span class="np-text">
        <span class="np-eyebrow">Právě hraje</span>
        <strong>{data.hraje.album}</strong>
        <span>{data.hraje.interpret}</span>
      </span>
    </figcaption>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
    padding-top: clamp(32px, 6vw, 72px);
    padding-bottom: clamp(64px, 9vw, 120px);
  }

  .hero-title {
    margin-top: 18px;
    font-size: clamp(2.6rem, 6.4vw, 6rem);
    line-height: 0.98;
    /* výšku podle nejdelšího slova nastaví skript, ať se stránka nehýbe, když se slovo změní */
    text-wrap: initial;
  }

  .hero-lead {
    margin-top: 28px;
    max-width: 44ch;
    font-size: 19px;
    color: var(--ink-2);
  }

  .hero-actions {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 28px;
  }

  .hero-media {
    position: relative;
    margin: 0;
  }

  .hero-media img {
    width: 100%;
    aspect-ratio: 4 / 4.4;
    object-fit: cover;
    object-position: 62% 50%;
    border-radius: var(--radius);
    box-shadow: 0 30px 60px -30px rgb(60 35 15 / 0.45);
  }

  .now-playing {
    position: absolute;
    left: clamp(-28px, -2vw, -12px);
    bottom: 28px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 18px 12px 12px;
    border-radius: 18px;
    background: var(--paper);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.7) inset,
      0 18px 40px -18px rgb(40 25 10 / 0.45),
      0 2px 6px rgb(40 25 10 / 0.08);
  }

  .np-disc {
    position: relative;
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background:
      radial-gradient(circle, transparent 0 34%, rgb(255 255 255 / 0.06) 35% 36%, transparent 37% 52%, rgb(255 255 255 / 0.06) 53% 54%, transparent 55%),
      conic-gradient(from 20deg, #26221d, #3a342c 12%, #1e1b17 25%, #36302a 40%, #1c1915 55%, #3b352d 70%, #201d19 85%, #26221d);
    animation: spin 1.8s linear infinite; /* 33⅓ otáčky za minutu */
  }

  .np-label {
    position: absolute;
    inset: 32%;
    border-radius: 50%;
    background: radial-gradient(circle, var(--paper) 0 12%, var(--accent) 13%);
  }

  .np-text {
    display: grid;
    line-height: 1.25;
    font-size: 14px;
    color: var(--ink-2);
  }

  .np-text strong {
    font-family: var(--serif);
    font-size: 19px;
    font-weight: 450;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .np-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-deep);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-media img {
      aspect-ratio: 4 / 3.2;
    }

    .now-playing {
      left: 12px;
      bottom: 12px;
    }
  }
</style>
