---
// Malá gramofonová deska: logo v hlavičce a favicon mají stejný tvar.
interface Props {
  class?: string;
  size?: number;
}
const { class: className, size = 28 } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <circle cx="16" cy="16" r="15.5" fill="#1c1915"></circle>
  <circle cx="16" cy="16" r="12.5" fill="none" stroke="#f4efe6" stroke-opacity=".14" stroke-width=".6"></circle>
  <circle cx="16" cy="16" r="10.2" fill="none" stroke="#f4efe6" stroke-opacity=".1" stroke-width=".6"></circle>
  <circle cx="16" cy="16" r="5.6" fill="#e0512f"></circle>
  <path d="M16 11.2a4.8 4.8 0 0 1 4.8 4.8" fill="none" stroke="#f4efe6" stroke-opacity=".55" stroke-width=".9" stroke-linecap="round"></path>
  <circle cx="16" cy="16" r="1.1" fill="#f4efe6"></circle>
</svg>
