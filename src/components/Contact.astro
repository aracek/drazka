---
import data from '../data/web.json';

type Den = { den: string; zavreno?: boolean; od?: string; do?: string };
const hours = data.oteviraci_doba as Den[];
---

<section id="kontakt" class="section section-alt">
  <div class="wrap contact">
    <div class="about">
      <p class="eyebrow">O nás</p>
      <h2>Desky pouštíme celé.</h2>
      <p class="about-text">{data.o_nas}</p>
    </div>

    <div class="visit">
      <h3>Přijď za námi</h3>
      <p class="visit-address">{data.adresa}</p>
      <a class="text-link" href={`mailto:${data.email}`}>{data.email}</a>

      <table class="hours">
        <caption class="sr-only">Otevírací doba</caption>
        <tbody>
          {
            hours.map((d, i) => (
              <tr data-day={i}>
                <th scope="row">{d.den}</th>
                <td>{d.zavreno || !d.od ? 'Zavřeno' : `${d.od}–${d.do}`}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(48px, 8vw, 120px);
    align-items: start;
  }

  .about h2 {
    margin-top: 16px;
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
  }

  .about-text {
    margin-top: 28px;
    max-width: 52ch;
    font-size: 19px;
    color: var(--ink-2);
  }

  .visit {
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.7) inset,
      0 24px 48px -32px rgb(40 25 10 / 0.35);
  }

  .visit h3 {
    font-size: 30px;
  }

  .visit-address {
    margin-top: 16px;
    font-size: 19px;
    font-weight: 550;
  }

  .visit .text-link {
    margin-top: 4px;
    color: var(--ink-2);
    font-weight: 500;
  }

  .hours {
    margin-top: 28px;
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .hours th,
  .hours td {
    padding: 10px 12px;
    border-top: 1px solid var(--line);
    text-align: left;
    font-weight: 450;
  }

  .hours td {
    text-align: right;
    color: var(--ink-2);
  }

  .hours tr:global(.is-today) th,
  .hours tr:global(.is-today) td {
    color: var(--ink);
    font-weight: 650;
    background: var(--paper-2);
  }

  .hours tr:global(.is-today) th {
    border-radius: 10px 0 0 10px;
  }

  .hours tr:global(.is-today) td {
    border-radius: 0 10px 10px 0;
  }

  @media (max-width: 860px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
